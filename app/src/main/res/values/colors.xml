<?xml version="1.0" encoding="utf-8"?>
<!--
    Only the two colours the pre-Compose window needs. The app's real palette lives in
    `MainActivity.ProhoriTheme`, in one place, where it can be reasoned about alongside the
    contrast decisions it exists to serve. Duplicating it here in XML would guarantee the
    two drift.
-->
<resources>
    <color name="prohori_surface">#FFF8F9F6</color>
    <color name="prohori_ink">#FF0A0A0A</color>
    <!-- The launcher icon's field. Same value as ProhoriTheme's light `primary`. -->
    <color name="prohori_primary">#FFB3261E</color>
</resources>
